# Copy to .env and fill in. NEVER commit .env. Never paste these into a chat.
#
# Get an API key: Capital.com -> Settings -> API integrations -> Generate.
# Generate it while your DEMO account is selected.

# demo | live   -- leave as demo
CAPITAL_ENV=demo

# Going live also requires this set to exactly: yes
# CAPITAL_I_UNDERSTAND_THIS_IS_REAL_MONEY=no

CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=your@email.com
CAPITAL_PASSWORD=your_api_key_custom_password

# ---- what to trade
CAPITAL_EPIC=GOLD
CAPITAL_RESOLUTION=MINUTE_5

# ---- risk (the numbers that actually matter)
RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=3.0
MAX_CONCURRENT_POSITIONS=1
STOP_DISTANCE_PCT=1.0
REWARD_TO_RISK=1.5

# ---- strategy
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# true = log intended trades without sending them. Keep true until you trust it.
DRY_RUN=true
POLL_SECONDS=300
